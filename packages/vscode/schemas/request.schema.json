{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1,
      "description": "File format version."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable name shown in the UI."
    },
    "description": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
      ]
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "description": "Full URL. May contain {{variables}}, e.g. {{baseUrl}}/api/posts."
    },
    "headers": {
      "default": {},
      "description": "Header name to value. Values may contain {{variables}}.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "query": {
      "default": {},
      "description": "Query parameters appended to the URL.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "body": {
      "default": {
        "type": "none"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "json"
            },
            "content": {
              "description": "Any JSON value. Strings may contain {{variables}}."
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "form"
            },
            "content": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              },
              "description": "Sent as application/x-www-form-urlencoded."
            }
          },
          "required": [
            "type",
            "content"
          ]
        }
      ],
      "description": "Request body."
    }
  },
  "required": [
    "version",
    "name",
    "method",
    "url"
  ],
  "description": "A RouteLens request (.req.json)."
}
