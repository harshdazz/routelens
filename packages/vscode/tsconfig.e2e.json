{
  // Extension tests run inside a real VS Code with Mocha, so they are compiled to CommonJS
  // (out/e2e) instead of being bundled like the extension.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node", "vscode", "mocha"],
    "rootDir": "test/e2e",
    "outDir": "out/e2e"
  },
  "include": ["test/e2e/**/*.ts"]
}
